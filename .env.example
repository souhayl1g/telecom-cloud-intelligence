# ───────────────────────────────────────────────────────────────
# NeXo Platform — Environment Configuration (example)
# Copy to .env to override defaults. All vars have safe dev defaults
# baked into docker-compose.yml; this file documents the surface area.
# ───────────────────────────────────────────────────────────────

# ── Docker Compose startup throttle ──────────────────────────────
# Prevents wsl-bootstrap STATUS_STACK_OVERFLOW (0xc00000fd) on WSL2/Windows.
# 4 containers start at a time instead of all 17 at once.
COMPOSE_PARALLEL_LIMIT=4

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET=telecom-dev-secret-change-in-prod
# Shared secret for service-to-service auth (ai-service, agent-service, retrain-service)
INTERNAL_API_KEY=nexo-internal-dev-key-change-in-prod
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FRONTEND_URL=http://localhost:3001

# ── Data ingestion ────────────────────────────────────────────
IMSI_SALT=nexo-tt-salt-2026

# ── Notebook container ────────────────────────────────────────
AUTO_PIPELINE=false
PIPELINE_MODE=oneshot
PIPELINE_TIMEOUT=120
JUPYTER_PORT=8888
JUPYTER_TOKEN=

# ── L4 Actuation Layer (2026-05-20) ──────────────────────────

# Retrain service
RETRAIN_SERVICE_URL=http://retrain-service:8004
RETRAIN_TIMEOUT_SECONDS=1800
RETRAIN_BUCKET=retrain-runs

# Reports (capacity PDFs in MinIO)
REPORTS_BUCKET=reports
REPORTS_URL_TTL_SECONDS=604800
# PUBLIC_S3_ENDPOINT is the URL the browser uses to fetch presigned
# objects. Leave as localhost for dev; override in production to your
# externally-reachable MinIO/CloudFront URL.
PUBLIC_S3_ENDPOINT=http://localhost:9000

# Twilio SMS (defense demo: leave empty → console-log fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# SMTP Email (defense demo: leave empty → console-log fallback)
#
# ── Option A: Gmail ──
#   1. Enable 2-Step Verification at https://myaccount.google.com/security
#   2. Generate an App Password: https://myaccount.google.com/apppasswords
#      (16-char string — paste into SMTP_PASS without spaces)
#   3. Set SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
#   4. SMTP_USER = the Gmail address that owns the App Password
#
# ── Option B: Elastic Email (free 100 emails/day) ──
#   1. Sign up at https://elasticemail.com
#   2. Go to Settings → SMTP → Create SMTP Key
#   3. SMTP_HOST=smtp.elasticemail.com, SMTP_PORT=2525
#   4. SMTP_USER = your Elastic Email username (usually your email)
#   5. SMTP_PASS = the SMTP key you generated (NOT your account password)
#
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NeXo Telecom Intelligence <nexo-noreply@tunisietelecom.tn>
ONCALL_EMAIL=noc-oncall@tunisietelecom.tn

# Dev-mode: when SMTP fails, return the reset link in the API response so the
# frontend can display it.  Set to true for local development / defense demos.
# NEVER enable in production — it leaks password-reset tokens to the browser.
DEV_SHOW_FALLBACK_LINK=true

# Capacity-report recipient (used by pb-capacity-report + /reports/capacity?email=true).
# Leave empty to disable auto-email (PDF is still uploaded to MinIO + presigned).
REPORT_RECIPIENT_EMAIL=
# Default SMS recipient for demo/console mode (used when an action has no per-target phone).
DEMO_SMS_RECIPIENT=

# Intervention tracker (pipeline-worker)
INTERVENTION_GRACE_MINUTES=120
INTERVENTION_IMPROVED_DELTA=0.05
INTERVENTION_WORSENED_DELTA=-0.05


# ── LLM Providers (L4 Agent Chat) ─────────────────────────────
# Primary: Google Gemini (recommended for defense day — fastest)
# Get API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash-preview-05-06

# Secondary: Kimi / Moonshot AI
# Get API key: https://platform.moonshot.cn/
KIMI_API_KEY=
KIMI_DEFAULT_MODEL=kimi-k2.5

# Tertiary: OpenRouter (free tier fallback)
# Get API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Free tier rotates; the chat route auto-falls-back across a verified free chain on 404/429.
OPENROUTER_DEFAULT_MODEL=google/gemma-4-31b-it:free

# Offline fallback: Ollama local
OLLAMA_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b
