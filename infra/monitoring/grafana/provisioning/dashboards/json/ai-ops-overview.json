{
    "id": null,
    "uid": "ai-ops-overview",
    "title": "AI Ops — Platform Health",
    "tags": ["ai-ops", "telecom", "cem-cvm"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 2,
    "refresh": "10s",
    "style": "dark",
    "editable": true,
    "panels": [
        {
            "type": "row",
            "title": "Service Health Overview",
            "id": 100,
            "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
            "collapsed": false
        },
        {
            "type": "stat",
            "title": "API Gateway — Request Rate",
            "id": 1,
            "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum(rate(http_requests_total{job=\"api-gateway\"}[5m]))",
                    "legendFormat": "req/s"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "thresholds" },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "#34d399", "value": null },
                            { "color": "#fbbf24", "value": 10 },
                            { "color": "#f87171", "value": 50 }
                        ]
                    },
                    "unit": "reqps"
                }
            },
            "options": {
                "reduceOptions": { "calcs": ["lastNotNull"] },
                "colorMode": "background",
                "graphMode": "area",
                "textMode": "auto"
            }
        },
        {
            "type": "stat",
            "title": "AI Service — Request Rate",
            "id": 2,
            "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum(rate(http_requests_total{job=\"ai-service\"}[5m]))",
                    "legendFormat": "req/s"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "thresholds" },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "#34d399", "value": null },
                            { "color": "#fbbf24", "value": 10 },
                            { "color": "#f87171", "value": 50 }
                        ]
                    },
                    "unit": "reqps"
                }
            },
            "options": {
                "reduceOptions": { "calcs": ["lastNotNull"] },
                "colorMode": "background",
                "graphMode": "area",
                "textMode": "auto"
            }
        },
        {
            "type": "stat",
            "title": "Error Rate (5xx)",
            "id": 3,
            "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum(rate(http_requests_total{status=~\"5..\",job=~\"api-gateway|ai-service\"}[5m])) or vector(0)",
                    "legendFormat": "5xx/s"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "thresholds" },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "#34d399", "value": null },
                            { "color": "#fbbf24", "value": 0.01 },
                            { "color": "#f87171", "value": 0.1 }
                        ]
                    },
                    "unit": "reqps",
                    "noValue": "0"
                }
            },
            "options": {
                "reduceOptions": { "calcs": ["lastNotNull"] },
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "auto"
            }
        },
        {
            "type": "stat",
            "title": "Latency p95",
            "id": 4,
            "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [
                {
                    "refId": "A",
                    "expr": "histogram_quantile(0.95, sum by(le) (rate(http_request_duration_seconds_bucket{job=~\"api-gateway|ai-service\"}[5m])))",
                    "legendFormat": "p95"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "thresholds" },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "#34d399", "value": null },
                            { "color": "#fbbf24", "value": 0.5 },
                            { "color": "#f87171", "value": 2 }
                        ]
                    },
                    "unit": "s",
                    "decimals": 3
                }
            },
            "options": {
                "reduceOptions": { "calcs": ["lastNotNull"] },
                "colorMode": "background",
                "graphMode": "area",
                "textMode": "auto"
            }
        },
        {
            "type": "row",
            "title": "Request Traffic",
            "id": 101,
            "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
            "collapsed": false
        },
        {
            "type": "timeseries",
            "title": "Request Rate by Service",
            "id": 5,
            "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by(job) (rate(http_requests_total{job=~\"api-gateway|ai-service\"}[5m]))",
                    "legendFormat": "{{job}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth",
                        "lineWidth": 2,
                        "fillOpacity": 15,
                        "gradientMode": "scheme",
                        "pointSize": 5,
                        "showPoints": "auto"
                    },
                    "color": { "mode": "palette-classic" },
                    "unit": "reqps"
                }
            },
            "options": {
                "legend": { "displayMode": "list", "placement": "bottom" },
                "tooltip": { "mode": "multi", "sort": "desc" }
            }
        },
        {
            "type": "timeseries",
            "title": "Request Rate by Endpoint",
            "id": 6,
            "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by(handler) (rate(http_requests_total{job=\"api-gateway\"}[5m]))",
                    "legendFormat": "{{handler}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "bars",
                        "lineWidth": 1,
                        "fillOpacity": 60,
                        "gradientMode": "scheme",
                        "stacking": { "mode": "normal" }
                    },
                    "color": { "mode": "palette-classic" },
                    "unit": "reqps"
                }
            },
            "options": {
                "legend": { "displayMode": "list", "placement": "bottom" },
                "tooltip": { "mode": "multi", "sort": "desc" }
            }
        },
        {
            "type": "row",
            "title": "Latency Analysis",
            "id": 102,
            "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
