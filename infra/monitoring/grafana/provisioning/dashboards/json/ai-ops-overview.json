        {
            "type": "row",
            "title": "HTTP Status Breakdown",
            "id": 103,
            "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
            "collapsed": false
        },
        {
            "type": "timeseries",
            "title": "Response Status Codes — API Gateway",
            "id": 9,
            "gridPos": { "h": 7, "w": 12, "x": 0, "y": 25 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by(status) (rate(http_requests_total{job=\"api-gateway\"}[5m]))",
                    "legendFormat": "HTTP {{status}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "bars",
                        "lineWidth": 1,
                        "fillOpacity": 50,
                        "stacking": { "mode": "normal" }
                    },
                    "color": { "mode": "palette-classic" },
                    "unit": "reqps"
                },
                "overrides": [
                    {
                        "matcher": { "id": "byRegexp", "options": ".*2\\d\\d.*" },
                        "properties": [{ "id": "color", "value": { "fixedColor": "#34d399", "mode": "fixed" } }]
                    },
                    {
                        "matcher": { "id": "byRegexp", "options": ".*4\\d\\d.*" },
                        "properties": [{ "id": "color", "value": { "fixedColor": "#fbbf24", "mode": "fixed" } }]
                    },
                    {
                        "matcher": { "id": "byRegexp", "options": ".*5\\d\\d.*" },
                        "properties": [{ "id": "color", "value": { "fixedColor": "#f87171", "mode": "fixed" } }]
                    }
                ]
            },
            "options": {
                "legend": { "displayMode": "list", "placement": "bottom" },
                "tooltip": { "mode": "multi" }
            }
        },
        {
            "type": "timeseries",
            "title": "Response Status Codes — AI Service",
            "id": 10,
            "gridPos": { "h": 7, "w": 12, "x": 12, "y": 25 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by(status) (rate(http_requests_total{job=\"ai-service\"}[5m]))",
                    "legendFormat": "HTTP {{status}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "bars",
                        "lineWidth": 1,
                        "fillOpacity": 50,
                        "stacking": { "mode": "normal" }
                    },
                    "color": { "mode": "palette-classic" },
                    "unit": "reqps"
                },
                "overrides": [
                    {
                        "matcher": { "id": "byRegexp", "options": ".*2\\d\\d.*" },
                        "properties": [{ "id": "color", "value": { "fixedColor": "#34d399", "mode": "fixed" } }]
                    },
                    {
                        "matcher": { "id": "byRegexp", "options": ".*4\\d\\d.*" },
                        "properties": [{ "id": "color", "value": { "fixedColor": "#fbbf24", "mode": "fixed" } }]
                    },
                    {
                        "matcher": { "id": "byRegexp", "options": ".*5\\d\\d.*" },
                        "properties": [{ "id": "color", "value": { "fixedColor": "#f87171", "mode": "fixed" } }]
                    }
                ]
            },
            "options": {
                "legend": { "displayMode": "list", "placement": "bottom" },
                "tooltip": { "mode": "multi" }
            }
        },
        {
            "type": "row",
            "title": "Endpoint Details",
            "id": 104,
            "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
            "collapsed": false
        },
        {
            "type": "table",
            "title": "Top Endpoints by Request Rate (5m)",
            "id": 11,
            "gridPos": { "h": 8, "w": 24, "x": 0, "y": 33 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by(job,handler,method,status) (rate(http_requests_total{job=~\"api-gateway|ai-service\"}[5m]))",
                    "format": "table",
                    "instant": true
                }
            ],
            "options": {
                "showHeader": true,
                "sortBy": [{ "displayName": "Value", "desc": true }],
                "footer": { "show": false }
            },
            "fieldConfig": {
                "defaults": {
                    "custom": { "align": "auto", "filterable": true }
                },
                "overrides": [
                    {
                        "matcher": { "id": "byName", "options": "Value" },
                        "properties": [
                            { "id": "unit", "value": "reqps" },
                            { "id": "decimals", "value": 4 },
                            { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
                            { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "transparent", "value": null }, { "color": "rgba(52,211,153,0.15)", "value": 0.001 }] } }
                        ]
                    }
                ]
            },
            "transformations": [
                {
                    "id": "organize",
                    "options": {
                        "excludeByName": { "Time": true },
                        "renameByName": {
                            "Value": "Rate (req/s)",
                            "job": "Service",
                            "handler": "Endpoint",
                            "method": "Method",
                            "status": "Status"
                        }
                    }
                }
            ]
        }
    ],
    "templating": {
        "list": [
            {
                "type": "query",
                "name": "job",
                "label": "Service",
                "datasource": { "type": "prometheus", "uid": "prometheus" },
                "query": "label_values(http_requests_total, job)",
                "regex": "api-gateway|ai-service",
                "refresh": 1,
                "includeAll": true,
                "multi": true,
                "current": { "selected": true, "text": ["All"], "value": ["$__all"] }
            }
        ]
    },
    "time": { "from": "now-1h", "to": "now" },
    "timepicker": {
        "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
    },
    "annotations": { "list": [] }
}
