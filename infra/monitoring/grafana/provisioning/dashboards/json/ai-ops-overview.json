                        "lineWidth": 2,
                        "fillOpacity": 8,
                        "gradientMode": "scheme",
                        "pointSize": 4,
                        "showPoints": "auto"
                    },
                    "color": { "mode": "palette-classic" },
                    "unit": "s"
                }
            },
            "options": {
                "legend": { "displayMode": "list", "placement": "bottom" },
                "tooltip": { "mode": "multi", "sort": "desc" }
            }
        },
        {
            "type": "timeseries",
            "title": "AI Service — Inference Latency Percentiles",
            "id": 8,
            "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [
                {
                    "refId": "A",
                    "expr": "histogram_quantile(0.50, sum by(le) (rate(http_request_duration_seconds_bucket{job=\"ai-service\"}[5m])))",
                    "legendFormat": "p50"
