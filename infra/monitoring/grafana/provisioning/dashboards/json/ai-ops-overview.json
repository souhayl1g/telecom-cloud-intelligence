                },
                {
                    "refId": "B",
                    "expr": "histogram_quantile(0.90, sum by(le) (rate(http_request_duration_seconds_bucket{job=\"api-gateway\"}[5m])))",
                    "legendFormat": "p90"
                },
                {
                    "refId": "C",
                    "expr": "histogram_quantile(0.95, sum by(le) (rate(http_request_duration_seconds_bucket{job=\"api-gateway\"}[5m])))",
                    "legendFormat": "p95"
