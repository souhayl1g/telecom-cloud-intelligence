# Telecom NeXoligence — Environment Variables
# Copy to .env and customize

# ─────────────────────────────────────────────────────────────
# Pipeline Configuration
# ─────────────────────────────────────────────────────────────

# Enable automatic pipeline execution on container startup
# Set to "true" for production deployment
AUTO_PIPELINE=false

# Pipeline execution mode
# - "oneshot": Run once and exit
# - "daemon": Continuous execution with 2-minute cycles
PIPELINE_MODE=oneshot

# Maximum time allowed for pipeline execution (seconds)
# Pipeline will be killed and marked as failed after this timeout
PIPELINE_TIMEOUT=120

# Log level: DEBUG, INFO, WARNING, ERROR
PIPELINE_LOG_LEVEL=INFO

# Enable idempotency guard (prevents duplicate runs)
PIPELINE_IDEMPOTENT=true

# Retry configuration
PIPELINE_MAX_RETRIES=3
PIPELINE_RETRY_DELAY=5

# ─────────────────────────────────────────────────────────────
# Jupyter Configuration
# ─────────────────────────────────────────────────────────────

# Jupyter server port
JUPYTER_PORT=8888

# Jupyter access token (leave empty for auto-generation)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JUPYTER_TOKEN=

# ─────────────────────────────────────────────────────────────
# Database (auto-configured by docker-compose)
# ─────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://telecom:telecom_pw@postgres:5432/telecom_intel

# ─────────────────────────────────────────────────────────────
# Object Storage (auto-configured by docker-compose)
# ─────────────────────────────────────────────────────────────

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio_pw

# ─────────────────────────────────────────────────────────────
# AI Service (auto-configured by docker-compose)
# ─────────────────────────────────────────────────────────────

AI_SERVICE_URL=http://ai-service:8001

# ─────────────────────────────────────────────────────────────
# Authentication (for production)
# ─────────────────────────────────────────────────────────────

JWT_SECRET=CHANGE_THIS_IN_PRODUCTION
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
