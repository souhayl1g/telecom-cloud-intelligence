FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY notebooks/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY notebooks/ /app/
COPY services/pipeline-worker/ /app/pipeline/
COPY services/ai-service/ /app/ai-service/
COPY entrypoint.sh /app/entrypoint.sh
COPY pipeline_runner.py /app/pipeline_runner.py

RUN mkdir -p /app/models /app/data /app/logs /app/pipeline/worker && \
    chmod +x /app/entrypoint.sh

RUN mkdir -p /usr/local/share/jupyter/kernels/telecom_ai && \
    echo '{"argv":["python","-m","jupyter_core","--hide-input-banner"],"display_name":"Telecom AI (Python 3.11)","language":"python"}' > /usr/local/share/jupyter/kernels/telecom_ai/kernel.json

EXPOSE 8888

ENTRYPOINT ["/app/entrypoint.sh"]
